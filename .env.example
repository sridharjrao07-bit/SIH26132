# =============================================================================
# SIH26132 — Krishi Bazaar: Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to git. Add it to .gitignore immediately.
# =============================================================================

# ── Supabase ──────────────────────────────────────────────────────────────────
# Find these in: Supabase Dashboard → Settings → API

# Your project's URL (e.g. https://abcdefghijkl.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Anon key: safe for client-side use, respects RLS policies
SUPABASE_ANON_KEY=your-anon-key-here

# Service role key: BYPASSES ALL RLS — used ONLY by ingestion/forecast/alert jobs
# NEVER expose this to the frontend or in API responses
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT secret: FastAPI verifies HS256 with this value (legacy JWT secret).
# Find in: Supabase Dashboard → Settings → API → JWT Settings → JWT Secret
# Locally minted tokens are NOT sent to PostgREST (signing-keys projects return PGRST301).
SUPABASE_JWT_SECRET=your-jwt-secret-here

# Optional issuer check (Supabase JWT `iss`, e.g. https://<ref>.supabase.co/auth/v1)
SUPABASE_JWT_ISSUER=

# Direct PostgreSQL connection string. Required by scripts/apply_migrations.py and SQLAlchemy.
SUPABASE_DB_URL=

# ── Data Sources ──────────────────────────────────────────────────────────────
# data.gov.in API key — free signup at https://data.gov.in/user/register
# Resource: 9ef84268-d588-465a-a308-a864a43d0070 (Daily Mandi Prices)
DATA_GOV_IN_API_KEY=your-data-gov-in-key-here

# Bing News Search API key — used by the event-ingestion pipeline to pull
# agriculture news for a district.  Free tier at
# https://www.microsoft.com/en-us/bing/apis/bing-news-search-api
# Leave blank to disable news ingestion (the pipeline logs a warning and skips).
BING_API_KEY=

# ── SMS Gateway ───────────────────────────────────────────────────────────────
# Set to 'mock' for demo (logs to sms_out.log). Set to 'msg91' for real SMS.
SMS_GATEWAY=mock

# MSG91 credentials — needed only when SMS_GATEWAY=msg91
MSG91_API_KEY=your-msg91-api-key-here
MSG91_SENDER_ID=KRBAZR

# TRAI DLT registration IDs — required for real SMS delivery in India
# Leave blank for demo; presence of these keys shows production-readiness to judges
MSG91_DLT_PE_ID=
MSG91_DLT_TE_ID_EN=
MSG91_DLT_TE_ID_MR=
MSG91_DLT_TE_ID_HI=

# ── Webhook Security ──────────────────────────────────────────────────────────
# REQUIRED in production. Must be set to a strong random secret.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Never use the default or a short value — the webhook triggers outbound SMS.
INBOUND_HMAC_SECRET=

# ── Scheduler ────────────────────────────────────────────────────────────────
# How often to run the ingestion job (in hours)
INGESTION_INTERVAL_HOURS=6

# Extremely wide sanity bound to prevent database overflow from bad units.
MAX_ARRIVAL_QTY_QTL=1000000.0

# How often to run the alert threshold checker (in minutes)
ALERT_CHECK_INTERVAL_MINUTES=60

# How often to run the forecasting job (in hours, after ingestion)
FORECAST_INTERVAL_HOURS=6

# Set to 0 to disable the background scheduler (e.g. under uvicorn --reload to prevent double-scheduling)
# Set to 1 (default) in production with a single worker.
RUN_SCHEDULER=1

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# Frontend origin(s) for CORS — comma-separated. Include the UI dev server.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Application-level rate limiting (set 0 in tests / local load-gen)
RATE_LIMIT_ENABLED=1

# ── District / Scope ─────────────────────────────────────────────────────────
# These scope the ingestion queries. Change to expand to other districts.
TARGET_DISTRICT=Nashik
TARGET_STATE=Maharashtra

# ── Optional adapters ─────────────────────────────────────────────────────────
# Set to 1 to enable the Agmarknet Selenium fallback scraper.
# Requires Chrome + ChromeDriver installed. NOT available on Render free tier.
ENABLE_AGMARKNET=0

# ── Auth DB enforcement ───────────────────────────────────────────────────────
# "app": service-role client used for authenticated requests.
#   Data isolation relies on application-layer .eq("user_id",...) filters.
#   Safe for development; blocked in production unless KB_ALLOW_APP_MODE=1.
# "rls" (default): per-request user-JWT client. PostgREST enforces RLS policies at the
#   DB boundary. Requires SUPABASE_JWT_ISSUER set and legacy JWT secret enabled.
AUTH_DB_ENFORCEMENT=rls

# Set to 1 to allow app-mode in production (not recommended).
KB_ALLOW_APP_MODE=

# Set to 1 to run live RLS probe tests against a real Supabase project.
# Requires SUPABASE_URL and SUPABASE_JWT_SECRET to point at the live project.
KB_LIVE_SUPABASE=

# ── Forecasting & Events ──────────────────────────────────────────────────────
# Which forecasting model to use: auto, feature_ols, holt_winters, ma, ols, gbm
FORECAST_MODEL=auto

# Event Intelligence Extraction
EVENT_JOB_ENABLED=0
EVENT_LLM=off
EVENT_LLM_PROVIDER=openai
EVENT_LLM_MODEL=gpt-4o-mini
EVENT_LLM_API_KEY=
EVENT_LLM_BASE_URL=
EVENT_SOURCES=pib,news,bulletin
BACKFILL_DAYS=730
EVENTS_SOURCE_MODE=off
INBOUND_SIG_HEADER=X-Signature
INBOUND_TS_HEADER=X-Timestamp

# ─── DirectLink retail price anchor (SIH26033) ───
# Live retail prices come from the Ministry of Consumer Affairs / Department of
# Consumer Affairs "State-wise Daily Wholesale and Retail Price of <commodity>"
# dataset on data.gov.in. Find the resource id by opening the dataset page and
# clicking API; it is configurable because data.gov.in re-issues UUIDs when the
# dataset is re-published.
# Without a key the loader falls back to the committed snapshot in
# data/gov_retail_prices.csv, so the demo still runs on real numbers.
DATA_GOV_IN_API_KEY=
DCA_RETAIL_RESOURCE_ID=
# Which source the retail anchor comes from: live (default) or snapshot.
# snapshot reads the committed DCA CSV directly -- same government figures, no
# network round trip. Use it when data.gov.in is down or the demo machine has no
# outbound access. The numbers are identical either way.
RETAIL_ANCHOR_SOURCE=live
# Per-commodity overrides, comma separated. Takes precedence over the single id.
DCA_RETAIL_RESOURCE_IDS=

# Fail-fast bounds for the live retail feed (seconds). A slow or unreachable
# data.gov.in must never hold up planning: the loader falls back to the snapshot.
# Defaults are shown; any garbage value degrades to the default rather than
# raising at startup.
DCA_RETAIL_CONNECT_TIMEOUT_SECONDS=3
DCA_RETAIL_TIMEOUT_SECONDS=5
DCA_RETAIL_DEADLINE_SECONDS=20
DCA_RETAIL_MAX_RETRY_WAIT_SECONDS=10
